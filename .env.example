# Server-side only. Never prefix any of these with NEXT_PUBLIC_ —
# that would inline them into the browser bundle.

# Hostaway credentials are NOT set here any more — they are entered in the
# app per account and stored encrypted (see CONTEXT.md §4a). These two are
# kept only for local scripts and the first-run bootstrap.
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# Master key for encrypting tenant credentials at rest. 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated. An empty allowlist denies everyone, by design.
AUTH_ALLOWED_EMAILS=

QUO_API_KEY=
QUO_FROM=
QUO_API_BASE=https://api.openphone.com/v1

# Optional: Airbnb scrape, used by the scheduled job only
GEMINI_API_KEY=
JINA_API_KEY=
