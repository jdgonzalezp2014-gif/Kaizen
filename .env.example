# Server-side only. Never prefix any of these with NEXT_PUBLIC_ —
# that would inline them into the browser bundle.

HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated. An empty allowlist denies everyone, by design.
AUTH_ALLOWED_EMAILS=

QUO_API_KEY=
QUO_FROM=
QUO_API_BASE=https://api.openphone.com/v1

# Optional: Airbnb scrape, used by the scheduled job only
GEMINI_API_KEY=
JINA_API_KEY=
