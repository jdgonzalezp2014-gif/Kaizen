{
  "name": "kaizen-os",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist",
    "test": "node --test src/lib/*.test.ts functions/_lib/*.test.ts",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "migrate:dry": "node --env-file=.env.local scripts/migrate.mjs --dry",
    "sync:units": "node --env-file=.env.local scripts/sync-units.mjs",
    "set:credentials": "node --env-file=.env.local scripts/set-credentials.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.7.1",
    "@neon/env": "^1.4.2",
    "@neondatabase/serverless": "^0.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^3.95.0"
  }
}
